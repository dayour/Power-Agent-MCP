{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src/mcp",
    "outDir": "./dist/mcp",
    "declaration": false,
    "sourceMap": true,
    "removeComments": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/mcp/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "test/**/*",
    "gulp/**/*",
    "src/tasks/**/*",
    "src/host/**/*",
    "src/parser/**/*",
    "src/params/**/*",
    "src/utilities/**/*",
    "src/mcp/standalone-server.ts"
  ]
}