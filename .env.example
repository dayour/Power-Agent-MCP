# Power Agent MCP - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# VSCode Marketplace
VSCE_PUBLISHER=your-publisher-id
VSCE_PAT=your-personal-access-token

# NuGet
NUGET_API_KEY=your-nuget-api-key
NUGET_SOURCE=https://api.nuget.org/v3/index.json

# Power Platform (for testing)
# User auth (recommended): sign in once with
#   pac auth create --deviceCode --applicationId $POWERPLATFORM_APPLICATION_ID --tenant $POWERPLATFORM_TENANT_ID
# Only TENANT_ID and APPLICATION_ID are required for user auth. CLIENT_SECRET is
# only needed if you intentionally fall back to service-principal auth.
POWERPLATFORM_TENANT_ID=your-tenant-id
POWERPLATFORM_APPLICATION_ID=your-application-id
# POWERPLATFORM_CLIENT_SECRET=  # leave unset for user auth
